# Quantum RSS Radar Environment Variables
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# ============ LLM API Keys ============
# Choose ONE provider: OpenAI or DeepSeek

# OpenAI Configuration
OPENAI_API_KEY="sk-..."

# OR DeepSeek Configuration
DEEPSEEK_API_KEY="sk-..."

# ============ Email Configuration (Optional) ============
# Set EMAIL_ENABLED=true to enable daily email digest

EMAIL_ENABLED=false
EMAIL_SENDER="your-email@example.com"
EMAIL_RECIPIENT="recipient@example.com"
EMAIL_SMTP_SERVER="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USERNAME="your-email@gmail.com"
EMAIL_SMTP_PASSWORD="your-app-password"

# ============ Additional Configuration ============
# Processing settings (can also be set in settings.yaml)

# Maximum papers to fetch from each RSS feed
MAX_PAPERS_PER_FEED=50

# Minimum relevance score (0-10) for recommendation
MIN_RELEVANCE_SCORE=5.0

# Number of top papers to include in email
TOP_N_RECOMMENDATIONS=10

# ============ Local Development Notes ============
# 1. Copy this file to .env
# 2. Fill in your actual API keys
# 3. .env is gitignored, so it won't be committed
# 4. For GitHub Actions, use GitHub Secrets instead

# ============ GitHub Secrets Mapping ============
# These environment variables correspond to GitHub Secrets:
#   OPENAI_API_KEY → OPENAI_API_KEY
#   DEEPSEEK_API_KEY → DEEPSEEK_API_KEY
#   EMAIL_SMTP_PASSWORD → EMAIL_SMTP_PASSWORD
#   ... etc.

# ============ Using with settings.yaml ============
# settings.yaml references these variables like:
#   api_key: "${OPENAI_API_KEY}"
# The system will automatically load .env and use these values.