# Quantum RSS Radar - Environment Variables Only Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============ LLM API Configuration ============
# Required: Your API key for OpenAI-compatible service
LLM_API_KEY=""

# Optional: Base URL for OpenAI-compatible API
# - DeepSeek: https://api.deepseek.com
# - OpenAI: https://api.openai.com
# - Azure OpenAI: https://your-resource.openai.azure.com/
# - Local (Ollama): http://localhost:11434/v1
LLM_BASE_URL=""

# Optional: Model name (default: deepseek-chat)
# - DeepSeek: deepseek-chat
# - OpenAI: gpt-4-turbo-preview, gpt-3.5-turbo
# - Custom: your-model-name
LLM_MODEL=""

# ============ Processing Settings ============
# Maximum papers to fetch from each RSS feed (default: 50)
MAX_PAPERS_PER_FEED="50"

# Minimum relevance score (0-10) for paper recommendation (default: 5.0)
MIN_RELEVANCE_SCORE="5.0"

# ============ Output Directories ============
# Base directory for processed data (default: data)
OUTPUT_DIR="data"

# Directory for generated website (default: web_output)
WEB_DIR="web_output"

# ============ Advanced Settings ============
# RSS feed fetch timeout in seconds (default: 30)
RSS_TIMEOUT="30"

# LLM API timeout in seconds (default: 60)
LLM_TIMEOUT="60"

# LLM temperature for analysis (0.0-1.0, default: 0.1)
LLM_TEMPERATURE="0.1"

# LLM max output tokens (default: 2500). Reasoning models (e.g. deepseek-v4-flash)
# may spend a large part of this budget on internal reasoning. If too small, the
# model runs out of tokens before writing JSON and returns empty content.
LLM_MAX_TOKENS="2500"

# LLM reasoning effort (default: low). deepseek-v4-flash keeps "thinking" until
# it exhausts max_tokens, which slows every call and can yield EMPTY content on
# long chain-of-thought. "low" caps it (fast + correct for relevance scoring);
# set "" to disable (send no reasoning_effort param), or "high" for deeper thought.
LLM_REASONING_EFFORT="low"

# Enable debug logging (default: false)
DEBUG="false"

# Enable arXiv deep reading (download PDF + LLM deep analysis) (default: true)
DEEP_READ_ENABLED="true"

# Enable LLM analysis cache to reduce API costs (default: true)
LLM_CACHE_ENABLED="true"

# Public website URL (used in emails and reports instead of hardcoded default)
PUBLIC_WEBSITE_URL=""

# ============ Email Configuration (Optional) ============
# Set EMAIL_ENABLED=true to enable daily email digest
EMAIL_ENABLED="false"

EMAIL_SENDER=""              # e.g. your-email@gmail.com
EMAIL_RECIPIENT=""           # e.g. your-email@gmail.com
EMAIL_SMTP_SERVER=""         # e.g. smtp.gmail.com for Gmail
EMAIL_SMTP_PORT="587"        # 587 (STARTTLS) most common; 465 (SSL) also supported
EMAIL_SMTP_USERNAME=""       # Usually the full email address
EMAIL_SMTP_PASSWORD=""       # App password (Gmail) or SMTP password

# Common SMTP settings:
#   Gmail:       smtp.gmail.com          Port 587  |  Use Google App Password (not account password)
#   Outlook:     smtp.office365.com      Port 587  |  Use account password or app password
#   QQ Mail:     smtp.qq.com             Port 587  |  Use SMTP authorization code
#   163 Mail:    smtp.163.com            Port 465  |  Use SMTP authorization code
#   SendGrid:    smtp.sendgrid.net       Port 587  |  Use API key as password

# ============ Email & Quarterly Web (Optional) ============
# Emails are driven entirely by config/rss_sources.yaml — each feed declares
# its own update_frequency (daily|weekday|weekly|monthly|season), min_score and
# max_items.  Feeds sharing an update_frequency are merged into ONE email:
#   weekday → Weekday Digest (Mon–Fri, e.g. arXiv) | weekly → Weekly Digest (Sun)
#   monthly → Monthly Digest (1st) | season → Seasonal Digest (quarter start)
# Set EMAIL_ENABLED=true to send these emails.

# JSONL archive directory used for email/quarterly aggregation.
# In CI this is fetched from the `data` branch before each run.
ARCHIVE_DIR="data/all"

# Quarter window (days) for the website's "Quarterly Best" view
QUARTER_WINDOW_DAYS="90"

# Top-N papers per category (Preprints / Publications) shown on the quarterly page
QUARTERLY_TOP_N="50"

# Enrich arXiv preprints with DOIs via the arXiv API (INFORMATIONAL only —
# product decision: arXiv and journal versions are different papers, so this
# does NOT affect dedup/identity).  Disabled by default.
ARXIV_DOI_ENRICH="false"

# ============ Quick Start ============
# 1. Copy this file to .env
# 2. Set LLM_API_KEY (required)
# 3. Optionally customize other settings
# 4. For email, set EMAIL_ENABLED=true and fill email settings
#    (Requires SMTP server + sender/recipient addresses)

# ============ Features ============
# - arXiv Deep Reading: High-score papers get PDF downloaded + full-text LLM analysis
# - LLM Cache: Repeated analyses use cached results to save API costs
# - RSS Sources: arXiv (quant-ph, cs, math) + Nature + APS + Science + IEEE

# ============ Notes ============
# - All settings can be overridden with environment variables
# - No YAML configuration files needed
# - For GitHub Actions, use GitHub Secrets with the same variable names
