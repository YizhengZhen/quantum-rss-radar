# Quantum RSS Radar Configuration
# This is an EXAMPLE configuration file
# Copy this to config/settings.yaml and customize for local development
# For GitHub Actions, use environment variables/GitHub Secrets instead

# IMPORTANT: For GitHub Actions deployment, you only need to set:
# - LLM_BASE_URL: API endpoint (e.g., https://api.deepseek.com)
# - LLM_MODEL: Model name (e.g., deepseek-chat)
# - LLM_API_KEY: API key
# These will automatically override the configuration below

# LLM Configuration - Generic OpenAI-compatible API
llm:
  # Provider is automatically detected from base_url
  provider: "generic"
  
  # Model name - can be overridden by LLM_MODEL environment variable
  model: "deepseek-chat"
  
  # API key - use environment variable
  api_key: "${LLM_API_KEY}"
  
  # Base URL for OpenAI-compatible API
  # Can be overridden by LLM_BASE_URL environment variable
  base_url: "https://api.deepseek.com"

# Email Configuration (optional - disabled by default)
email:
  enabled: false
  
  # Email settings - use environment variables if enabled
  sender: "${EMAIL_SENDER}"
  recipient: "${EMAIL_RECIPIENT}"
  smtp_server: "${EMAIL_SMTP_SERVER}"
  smtp_port: 587
  smtp_username: "${EMAIL_SMTP_USERNAME}"
  smtp_password: "${EMAIL_SMTP_PASSWORD}"

# Processing Settings
processing:
  max_papers_per_feed: 50
  min_relevance_score: 5.0
  top_n_recommendations: 10

# Output Directories
output_dir: "data"
web_dir: "jekyll_site/_site"  # Jekyll output directory